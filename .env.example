# Supabase project (Project Settings -> API)
# Only public values belong here: the URL and the ANON key.
# Never put the service_role key in a Vite app — it gets shipped to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Checkout server the dashboard talks to. If unset, defaults to the deployed
# server: https://checkout-production-bbfe.up.railway.app/api
# Set VITE_API_URL=/api to use the Vite dev proxy instead.
VITE_API_URL=https://checkout-production-bbfe.up.railway.app/api